@@ -0,0 +1,71 @@
+import { useState } from 'react';
+import { navigate } from '../../App';
+import { createExam } from '../../api/exams';
+import { NAME_MAX, isNameTooLong, useSubjects } from '../../shared';
+import { BottomSheet, Button, Pressable, SubjectDot, TextField, Toggle } from '../../ui/index.js';
+
+export default function ExamSheet() {
+  const { subjects, loading } = useSubjects();
+  const [name, setName] = useState('');
+  const [picked, setPicked] = useState<string | null>(null);
+  const [listing, setListing] = useState(false);
+  const [date, setDate] = useState('');
+  const [notify, setNotify] = useState(true);
+
+  if (loading) return null;
+  const pickedId = picked ?? subjects[0]?.id ?? null;
+  const current = subjects.find((s) => s.id === pickedId);
+  const tooLong = isNameTooLong(name);
+  const can = name.trim() !== '' && !tooLong && date !== '';
+
+  const save = async () => {
+    const { status } = await createExam({ name: name.trim(), subjectId: pickedId!, date, notify });
+    if (status === 201) navigate('/');
+  };
+
+  if (listing) {
+    return (
+      <BottomSheet title="과목 선택">
+        <ul className="flex flex-col gap-2">
+          {subjects.map((s) => (
+            <li key={s.id}>
+              <Pressable onClick={() => { setPicked(s.id); setListing(false); }} className="flex h-[48px] w-full items-center rounded-lg bg-canvas px-4">
+                <SubjectDot color={s.color} className="mr-3" />
+                <span className="text-[15px] font-bold text-primary">{s.name}</span>
+              </Pressable>
+            </li>
+          ))}
+        </ul>
+      </BottomSheet>
+    );
+  }
+
+  return (
+    <BottomSheet title="시험 일정 추가">
+      <TextField
+        aria-label="시험 이름"
+        placeholder="시험 이름"
+        value={name}
+        onChange={setName}
+        id="exam-name"
+        error={tooLong ? `이름은 ${NAME_MAX}자까지 쓸 수 있어요. 조금 줄여 주세요` : undefined}
+        trailing={tooLong && <span className="text-[12px] text-secondary">{[...name.trim()].length}/{NAME_MAX}</span>}
+      />
+      <Pressable onClick={() => setListing(true)} className="mt-2 flex h-[44px] w-full items-center justify-between">
+        <span className="text-[14px] font-medium text-primary">과목</span>
+        <span className="flex items-center text-[14px] text-secondary">
+          {current && <SubjectDot color={current.color} className="mr-2" />}
+          {current?.name} ›
+        </span>
+      </Pressable>
+      <div className="mt-2">
+        <TextField type="date" aria-label="날짜" value={date} onChange={setDate} />
+      </div>
+      <div className="mt-4 flex items-center justify-between">
+        <span className="text-[14px] font-medium text-primary">시험 하루 전 알림</span>
+        <Toggle aria-label="시험 하루 전 알림" checked={notify} onChange={setNotify} />
+      </div>
+      <Button className="mt-4 w-full" disabled={!can} onClick={save}>저장하기</Button>
+    </BottomSheet>
+  );
+}
