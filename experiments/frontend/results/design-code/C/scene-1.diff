+export default function SaveButton({ pending, disabled, children, ...rest }) {
+  return (
+    <Button disabled={disabled || pending} {...rest}>
+      {pending && (
+        <span aria-hidden="true" className="mr-2 inline-block h-4 w-4 animate-spin rounded-full border-2 border-current border-t-transparent" />
+      )}
+      {children}
+    </Button>
+  );
+}
